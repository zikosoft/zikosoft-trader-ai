# ZikosoftTrader AI — variables d'environnement (exemple, aucune valeur sensible)
# Copier en .env et renseigner les valeurs réelles. Ne JAMAIS committer .env.

# --- Application ---
APP_ENV=local
APP_NAME=zikosofttrader-ai
APP_BASE_URL=http://localhost:8080

# --- Démo (B05) ---
DEMO_USER_EMAIL=demo@zikosofttrader.local
DEMO_USER_PASSWORD=demo
# Expose GET /api/auth/demo-credentials (pratique pour un jury de hackathon).
# Mettre à false si l'environnement déployé doit être durci (voir B32/B38).
DEMO_CREDENTIALS_VISIBLE=true

# --- Authentification locale (B05) ---
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=zikosoft_session
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (B05) ---
# Cible du proxy Vite pour /api — à l'intérieur de Docker Compose ça doit
# être le nom du service backend-api ; en dev local hors Docker, pointer
# vers votre backend-api lancé à la main (ex. http://localhost:8000).
VITE_API_PROXY_TARGET=http://backend-api:8000

# --- PostgreSQL (B03) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zikosofttrader
POSTGRES_USER=zikosofttrader
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://zikosofttrader:change-me-local-only@postgres:5432/zikosofttrader

# --- Redis (B04) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Chiffrement des secrets (B08) ---
# Doit être une clé Fernet valide (32 octets aléatoires encodés base64
# urlsafe AVEC padding — `secrets.token_urlsafe()` ne convient PAS, il retire
# le padding et produit une clé invalide pour Fernet). Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Cette clé ne doit jamais être versionnée ni placée dans un ZIP de livraison.
# Générez votre propre valeur dans `.env` avant de saisir une clé Alpaca ou
# Claude dans l'interface :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- Alpaca (B07, laissé vide en local — saisi via l'onboarding UI) ---
# Ces variables ne sont PAS utilisées pour l'auto-connexion : elles ne servent
# qu'aux tests automatisés qui mockent Alpaca (voir B33 — Alpaca est un tiers
# externe, pas notre infra, donc hors de la règle "pas de mock" appliquée à
# PostgreSQL/Redis/notre propre API).
ALPACA_TEST_API_KEY=
ALPACA_TEST_SECRET_KEY=
# V1 Paper uniquement, volontairement non configurable (§B07 "Mode Paper
# verrouillé") — pas de variable pour pointer vers l'API live.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# Read-only option-chain market data host (contracts remain on the Paper API).
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# B17 — flux WebSocket `trade_updates` utilisé par l'Order Worker
# (`workers/order_worker/trade_updates_listener.py`), même verrouillage
# Paper que ci-dessus.
ALPACA_PAPER_STREAM_URL=wss://paper-api.alpaca.markets/stream

# --- Fournisseur IA (B10, D017/D026) ---
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL_HIGH_STAKES=claude-sonnet-4-5
AI_MODEL_LOW_STAKES=claude-haiku-4-5
AI_MAX_CALLS_PER_MINUTE=30
# UI-editable Claude controls are persisted in Redis (these are bootstrap
# defaults only; API keys entered in Settings are encrypted server-side).
AI_MAX_CALLS_PER_DAY=50
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=20
# Budget sélectionné dans l'interface au premier démarrage. Il reste
# modifiable par l'utilisateur connecté, mais seulement jusqu'au plafond
# propriétaire ci-dessous.
AI_DAILY_BUDGET_USD=2
# Plafond serveur non modifiable depuis l'interface. Modifiez cette valeur
# uniquement dans votre `.env`, puis redémarrez les services. L'application
# refusera toute tentative de l'interface qui le dépasse.
AI_DAILY_BUDGET_HARD_CAP_USD=10
AI_CALLS_ENABLED=true

# --- Telegram (B21, optionnel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analytics (B37, uniquement sur l'environnement déployé) ---
GTM_CONTAINER_ID=
GA_MEASUREMENT_ID=

# --- Observabilité (B24) ---
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# --- Watchdog (B22) ---
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TTL_SECONDS=15

# --- Risk Engine déterministe (B15) ---
# Délai minimum entre deux décisions de risque pour une même stratégie
# (§"Contrôle cooldown"). Un cooldown actif REJETTE automatiquement — c'est
# un frein de rythme, pas une simple alerte.
RISK_ENGINE_COOLDOWN_SECONDS=60

# --- Options risk gates (Paper demo, one-leg long options only) ---
# Server-side limits; keep these separate from Claude token/spend limits.
OPTIONS_MAX_PREMIUM_PER_ORDER=500
OPTIONS_MAX_CONTRACTS=1
OPTIONS_MAX_SPREAD_PCT=0.20
OPTIONS_MIN_DTE=7
OPTIONS_MAX_DTE=30

# --- Portfolio Worker (B18) ---
# Délai minimum entre deux snapshots portefeuille pour un même contexte
# d'exécution (worker `workers/portfolio_worker/main.py`) — basé sur
# MAX(portfolio_snapshots.snapshot_at) en base, pas un état en mémoire (voir
# docstring du worker : survit à un redémarrage).
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=300
